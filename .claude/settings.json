{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(git rev-parse*)",
      "Bash(git remote -v)",
      "Bash(git check-ignore*)",
      "Bash(git ls-files*)",
      "Bash(git tag*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh repo view*)",
      "Bash(gh api repos/*)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv add*)",
      "Bash(uv run *)",
      "Bash(uv --version)",
      "Bash(pnpm install*)",
      "Bash(pnpm add*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm format*)",
      "Bash(pnpm build*)",
      "Bash(pnpm -s *)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm infra:*)",
      "Bash(docker compose *)",
      "mcp__notion"
    ],
    "ask": [
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --input *)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin develop*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:develop*)",
      "Bash(rm -rf*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.production)",
      "Read(**/secrets/**)",
      "Read(private/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
