{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git merge origin/develop*)",
      "Bash(git push origin phase-*)",
      "Bash(git push -u origin phase-*)",
      "Bash(git push origin v*)",
      "Bash(git stash*)",
      "Bash(git rev-parse*)",
      "Bash(git remote -v)",
      "Bash(git check-ignore*)",
      "Bash(git ls-files*)",
      "Bash(git tag*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh repo view*)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv add*)",
      "Bash(uv run *)",
      "Bash(uv --version)",
      "Bash(pnpm install*)",
      "Bash(pnpm add*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm format*)",
      "Bash(pnpm build*)",
      "Bash(pnpm -s *)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm infra:*)",
      "Bash(docker compose *)",
      "mcp__notion"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git tag -d*)",
      "Bash(git tag * -d*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * +*)",
      "Bash(git push * :*)",
      "Bash(git push *:main*)",
      "Bash(git push *:develop*)",
      "Bash(git push *:refs/heads/*)",
      "Bash(git push origin main*)",
      "Bash(git push origin develop*)",
      "Bash(git push -u origin main*)",
      "Bash(git push -u origin develop*)",
      "Bash(rm -rf*)",
      "Bash(cat .env*)",
      "Bash(source .env*)",
      "Bash(* .env)",
      "Bash(* .env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(private/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
