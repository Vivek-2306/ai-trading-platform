{
  "name": "ai-trading-platform",
  "private": true,
  "description": "AI-powered trading research and signal platform (monorepo root)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "turbo run format",
    "build": "turbo run build",
    "infra:up": "docker compose --project-directory . -f infra/docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose --project-directory . -f infra/docker-compose.dev.yml down",
    "infra:logs": "docker compose --project-directory . -f infra/docker-compose.dev.yml logs -f",
    "infra:ps": "docker compose --project-directory . -f infra/docker-compose.dev.yml ps",
    "db:migrate": "pnpm --filter @aitp/api db:migrate",
    "worker": "pnpm --filter @aitp/api worker",
    "beat": "pnpm --filter @aitp/api beat",
    "test:integration": "pnpm --filter @aitp/api test:integration"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  }
}
