# Copy to infra/prod.env and fill in. Never commit the copy (it is git-ignored).
# Compose reads it with: docker compose --env-file infra/prod.env -f infra/docker-compose.prod.yml ...

# Required: a long random password. Use letters and digits only (it goes inside a URL):
#   openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_USER=trading
POSTGRES_DB=trading

# A domain name gives automatic HTTPS; ":80" serves plain HTTP (testing only).
SITE_ADDRESS=:80
# The browser talks only to the web app, so this can stay as is.
CORS_ORIGINS=http://localhost

LOG_LEVEL=info
# paper | live. Keep paper until live trading is explicitly approved.
TRADING_MODE=paper

# Optional
SENTRY_DSN=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GIT_SHA=

# Host ports (change only if 80/443 are taken)
HTTP_PORT=80
HTTPS_PORT=443
