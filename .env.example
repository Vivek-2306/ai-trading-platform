# Copy to .env and fill in. Never commit .env.
# Values here are safe local-dev defaults or empty placeholders.

# --- App ---
# development | test | production
APP_ENV=development
# debug | info | warning | error
LOG_LEVEL=info
# paper | live — live trading stays off until explicitly approved
TRADING_MODE=paper

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins allowed to call the API (the web app in dev)
CORS_ORIGINS=http://localhost:3000

# --- Database (matches infra/docker-compose.dev.yml) ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_dev
POSTGRES_DB=trading
DATABASE_URL=postgresql+asyncpg://trading:trading_dev@localhost:5432/trading

# --- Redis / workers ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Web app ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Security ---
# 32-byte key (base64) used to encrypt broker API keys at rest
BROKER_KEY_ENCRYPTION_KEY=

# --- AI ---
ANTHROPIC_API_KEY=
AI_MODEL_BULK=claude-haiku-5-5
AI_MODEL_REASONING=claude-opus-5-5
VOYAGE_API_KEY=

# --- Market data and brokers ---
# Zerodha Kite Connect (India: NSE, BSE, F&O, currency derivatives)
KITE_API_KEY=
KITE_API_SECRET=
# Alpaca (US stocks, paper trading)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
POLYGON_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Monitoring ---
SENTRY_DSN=
