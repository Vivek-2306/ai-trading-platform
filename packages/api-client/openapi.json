{
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InstrumentQuality": {
        "properties": {
          "candles": {
            "title": "Candles",
            "type": "integer"
          },
          "gap_runs": {
            "title": "Gap Runs",
            "type": "integer"
          },
          "inconsistent_candles": {
            "title": "Inconsistent Candles",
            "type": "integer"
          },
          "latest": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest"
          },
          "missing_candles": {
            "title": "Missing Candles",
            "type": "integer"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "spikes": {
            "title": "Spikes",
            "type": "integer"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "timeframe": {
            "title": "Timeframe",
            "type": "string"
          },
          "venue": {
            "title": "Venue",
            "type": "string"
          }
        },
        "required": [
          "venue",
          "symbol",
          "timeframe",
          "ok",
          "candles",
          "latest",
          "missing_candles",
          "gap_runs",
          "stale",
          "inconsistent_candles",
          "spikes"
        ],
        "title": "InstrumentQuality",
        "type": "object"
      },
      "QualityResponse": {
        "properties": {
          "instruments": {
            "items": {
              "$ref": "#/components/schemas/InstrumentQuality"
            },
            "title": "Instruments",
            "type": "array"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "instruments"
        ],
        "title": "QualityResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "unavailable"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "git_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Git Sha"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "git_sha",
          "environment"
        ],
        "title": "VersionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AI Trading Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/data/quality": {
      "get": {
        "description": "Per instrument and timeframe, over the last 30 days: missing candles (market-hours\naware), stale data, candles whose open or close lies outside high-low, and price spikes.",
        "operationId": "quality_data_quality_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualityResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Data-quality report",
        "tags": [
          "data"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Returns ok while the process is up. It does not check dependencies; see /health/ready.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness check",
        "tags": [
          "system"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Checks every dependency (database, and Redis once added). 503 if any is down.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "A dependency is down"
          }
        },
        "summary": "Readiness check",
        "tags": [
          "system"
        ]
      }
    },
    "/version": {
      "get": {
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Running version",
        "tags": [
          "system"
        ]
      }
    }
  }
}
